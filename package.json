    "url": "https://github.com/eyeoverthink/sva-standard.git"
  },
  "homepage": "https://eyeoverthink.github.io/sva-standard/",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "conformance:node": "node conformance/v1/runners/node-verify.mjs",
    "conformance:webcrypto": "node conformance/v1/runners/webcrypto-verify.mjs",
    "conformance:java": "java conformance/v1/runners/SvaConformance.java conformance/v1/vectors.json",
    "conformance": "node conformance/v1/runners/node-verify.mjs && node conformance/v1/runners/webcrypto-verify.mjs && java conformance/v1/runners/SvaConformance.java conformance/v1/vectors.json",
